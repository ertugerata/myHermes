#!/bin/bash

# MyHermes Docker Konteyner Başlatma Betiği
# Bu betik, gereksiz portları kapatılmış ve optimize edilmiş olarak
# Hermes Agent docker konteynerini arka planda başlatır.

# .env dosyası yoksa dur ve kullanıcıyı bilgilendir
if [ ! -f ".env" ]; then
    echo "❌ HATA: .env dosyası bulunamadı!"
    echo "    Lütfen önce 'bash scripts/setup-wizard.sh' komutunu çalıştırın"
    echo "    ya da OPENROUTER_API_KEY, HERMES_DASHBOARD_BASIC_AUTH_USERNAME ve"
    echo "    HERMES_DASHBOARD_BASIC_AUTH_PASSWORD değerlerini içeren bir .env dosyası oluşturun."
    exit 1
fi

# Varsa eski konteyneri durdur ve sil
if docker ps -a --format '{{.Names}}' | grep -Eq "^hermes$"; then
    echo "Eski 'hermes' konteyneri durduruluyor ve kaldırılıyor..."
    docker stop hermes >/dev/null 2>&1 || true
    docker rm hermes >/dev/null 2>&1 || true
fi

echo "Veri saklama (Volume Mount) yöntemini seçin:"
echo "  1) Yerel Ev Dizini (Host üzerindeki ~/.hermes klasörünü bağlar - Önerilen)"
echo "  2) Docker Hacmi (hermes-data adında izole bir Docker Named Volume kullanır)"
read -rp "Seçiminiz (1-2) [Varsayılan: 1]: " volume_choice
volume_choice=${volume_choice:-1}

if [ "$volume_choice" = "1" ]; then
  echo "✔ Yerel ev dizini (~/.hermes) kullanılacak."
  mkdir -p "$HOME/.hermes"
  VOLUME_MOUNT="-v $HOME/.hermes:/home/user/.hermes"
else
  echo "✔ Docker Hacmi (hermes-data) kullanılacak."
  VOLUME_MOUNT="-v hermes-data:/home/user/.hermes"
fi

echo "Hermes Agent konteyneri başlatılıyor..."
docker run -d \
  --name hermes \
  -p 7860:7860 \
  -p 7861:7861 \
  $VOLUME_MOUNT \
  --env-file .env \
  my-hermes-agent

echo "Hermes Agent başarıyla başlatıldı!"
echo "Dashboard: http://localhost:7860"
echo "Web TUI: http://localhost:7861"