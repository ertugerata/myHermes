#!/bin/bash

# MyHermes Docker Konteyner Başlatma Betiği
# Bu betik, gereksiz portları kapatılmış ve optimize edilmiş olarak
# Hermes Agent docker konteynerini arka planda başlatır.

if [ "${1:-}" = "wizard" ] || [ "${1:-}" = "--wizard" ] || [ "${1:-}" = "-w" ]; then
    exec bash scripts/setup-wizard.sh
fi

# .env dosyası yoksa kullanıcıya sihirbazı çalıştırma seçeneği sun
if [ ! -f ".env" ]; then
    echo "❌ HATA: .env dosyası bulunamadı!"
    read -rp "İnteraktif Kurulum Sihirbazı (setup-wizard.sh) çalıştırılsın mı? (e/h) [Varsayılan: e]: " run_wiz
    run_wiz=${run_wiz:-e}
    if [[ "$run_wiz" =~ ^[EeYy]$ ]]; then
        exec bash scripts/setup-wizard.sh
    else
        echo "Lütfen bir .env dosyası oluşturun veya 'bash scripts/setup-wizard.sh' komutunu çalıştırın."
        exit 1
    fi
fi

# .env dosyasındaki çevre değişkenlerini yükle
set -a
source .env 2>/dev/null || true
set +a

# Varsa eski konteyneri durdur ve sil
if docker ps -a --format '{{.Names}}' | grep -Eq "^hermes$"; then
    echo "Eski 'hermes' konteyneri durduruluyor ve kaldırılıyor..."
    docker stop hermes >/dev/null 2>&1 || true
    docker rm hermes >/dev/null 2>&1 || true
fi

echo "Veri saklama (Volume Mount) yöntemini seçin:"
echo "  1) Yerel Ev Dizini (Host üzerindeki ~/.hermes klasörünü bağlar - Önerilen)"
echo "  2) Docker Hacmi (hermes-data adında izole bir Docker Named Volume kullanır)"
read -rp "Seçiminiz (1-2) [Varsayılan: 1]: " volume_choice
volume_choice=${volume_choice:-1}

APP_PORT="${PORT:-7860}"

DOCKER_ARGS=(
    run -d
    --name hermes
    -p "$APP_PORT:$APP_PORT"
)

if [ "$volume_choice" = "1" ]; then
    echo "✔ Yerel ev dizini (~/.hermes) kullanılacak."
    mkdir -p "$HOME/.hermes"
    DOCKER_ARGS+=(-v "$HOME/.hermes:/home/user/.hermes")
else
    echo "✔ Docker Hacmi (hermes-data) kullanılacak."
    DOCKER_ARGS+=(-v "hermes-data:/home/user/.hermes")
fi

# Local PDF Summarizer dizin bağlantılarını ekle
if [ "${PDF_SUMMARIZER_TARGET_TYPE:-local}" = "local" ]; then
    if [ -n "${PDF_SUMMARIZER_LOCAL_READING_LIST:-}" ]; then
        mkdir -p "$PDF_SUMMARIZER_LOCAL_READING_LIST"
        DOCKER_ARGS+=(-v "$PDF_SUMMARIZER_LOCAL_READING_LIST:$PDF_SUMMARIZER_LOCAL_READING_LIST")
    fi
    if [ -n "${PDF_SUMMARIZER_LOCAL_SHELVES:-}" ]; then
        mkdir -p "$PDF_SUMMARIZER_LOCAL_SHELVES"
        DOCKER_ARGS+=(-v "$PDF_SUMMARIZER_LOCAL_SHELVES:$PDF_SUMMARIZER_LOCAL_SHELVES")
    fi
fi

DOCKER_ARGS+=(--env-file .env my-hermes-agent)

echo "Hermes Agent konteyneri başlatılıyor..."
docker "${DOCKER_ARGS[@]}"

echo "Hermes Agent başarıyla başlatıldı!"
echo "Dashboard: http://localhost:$APP_PORT"