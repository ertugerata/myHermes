#!/bin/bash

# MyHermes Docker Compose Başlatma Betiği
# Bu betik, Hermes Agent ve entegre Ofelia zamanlayıcısını Docker Compose ile arka planda başlatır.

if [ "${1:-}" = "wizard" ] || [ "${1:-}" = "--wizard" ] || [ "${1:-}" = "-w" ]; then
    exec bash scripts/setup-wizard.sh
fi

# .env dosyası yoksa kullanıcıya sihirbazı çalıştırma seçeneği sun
if [ ! -f ".env" ]; then
    echo "❌ HATA: .env dosyası bulunamadı!"
    read -rp "İnteraktif Kurulum Sihirbazı (setup-wizard.sh) çalıştırılsın mı? (e/h) [Varsayılan: e]: " run_wiz
    run_wiz=${run_wiz:-e}
    if [[ "$run_wiz" =~ ^[EeYy]$ ]]; then
        exec bash scripts/setup-wizard.sh
    else
        echo "Lütfen bir .env dosyası oluşturun veya 'bash scripts/setup-wizard.sh' komutunu çalıştırın."
        exit 1
    fi
fi

# .env dosyasındaki çevre değişkenlerini yükle
set -a
source .env 2>/dev/null || true
set +a

# Submodule'leri güncelle
echo "Git Submodule'ler güncelleniyor..."
git submodule update --init --recursive 2>/dev/null || true

# Yerel PDF Summarizer dizinleri tanımlıysa önceden oluştur
if [ "${PDF_SUMMARIZER_TARGET_TYPE:-local}" = "local" ]; then
    RL_PATH="${PDF_SUMMARIZER_LOCAL_READING_LIST:-./Bilgi_Tabani/02_Okuma_Listesi}"
    SH_PATH="${PDF_SUMMARIZER_LOCAL_SHELVES:-./Bilgi_Tabani/03_Akilli_Raflar}"
    mkdir -p "$RL_PATH" "$SH_PATH" 2>/dev/null || true
fi

# Docker Compose komutunu tespit et
if docker compose version &>/dev/null; then
    COMPOSE_CMD="docker compose"
elif command -v docker-compose &>/dev/null; then
    COMPOSE_CMD="docker-compose"
else
    echo "❌ HATA: Sisteminizde 'docker compose' veya 'docker-compose' komutu bulunamadı!"
    echo "Lütfen Docker Compose yükleyin."
    exit 1
fi

APP_PORT="${PORT:-7860}"
SERVER_IP=$(hostname -I 2>/dev/null | awk '{print $1}')

echo "Hermes Agent (ve entegre Ofelia zamanlayıcısı) Docker Compose ile başlatılıyor..."
$COMPOSE_CMD up -d --build

echo "✔ Hermes Agent başarıyla başlatıldı!"
echo "Dashboard (Yerel / Local):   http://localhost:$APP_PORT"
if [ -n "$SERVER_IP" ] && [ "$SERVER_IP" != "127.0.0.1" ]; then
    echo "Dashboard (Sunucu / Server): http://$SERVER_IP:$APP_PORT"
else
    echo "Dashboard (Sunucu / Server): http://<SUNUCU_IP>:$APP_PORT"
fi
